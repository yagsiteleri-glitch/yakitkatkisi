---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import blogPosts from '../data/blogPosts.json';

const jetProducts = products.filter(p => (p.brandSlug || p.brand) === 'jet');
const vpProducts = products.filter(p => (p.brandSlug || p.brand) === 'vp-racing');
const lmProducts = products.filter(p => (p.brandSlug || p.brand) === 'liqui-moly');
---

<Layout
  title="Yakıt Katkısı & Yarış Yakıtı Fiyatları & Çeşitleri | Orijinal Ürünler"
  description="VP Racing Octanium, Liqui Moly Cera Tec, JET Motorsport E85, E98 etanol, metanol, toluen ve yüksek performanslı yarış yakıtı katkıları stoktan aynı gün sevkiyat."
>
  <!-- HERO BRAND BANNERS SHOWCASE -->
  <section class="banner-grid-section" aria-label="Markalarımız ve Yakıt Katkısı & Yarış Yakıtı Çeşitleri">
    <div class="container">
      <div class="banner-mosaic-showcase">
        <!-- Big Featured Banner: JET Motorsport (Hero) -->
        <article class="banner-hero-main">
          <a href="#jet" class="banner-hero-link" aria-label="JET Motorsport Yarış Yakıtları Sayfasına Git">
            <div class="banner-hero-bg">
              <img
                src="/images/banners/hero-artoil.jpg"
                alt="JET Motorsport Yarış Yakıtları"
                width="720"
                height="420"
                loading="eager"
              />
              <div class="hero-overlay-gradient"></div>
            </div>
            <div class="banner-hero-content">
              <div class="hero-tag-row">
                <span class="hero-brand-pill">
                  <i class="fas fa-shield-alt"></i>
                  <span>Yetkili Satış Noktası</span>
                </span>
                <span class="hero-badge-count">{products.length} Çeşit</span>
              </div>
              <h1 class="hero-banner-title">
                JET, VP Racing & Liqui Moly
                <span class="hero-highlight">Yakıt Katkıları</span>
              </h1>
              <p class="hero-banner-desc">
                Pist, drag ve yüksek performans araçları için oktan arttırıcılar, saf E85/E98 etanol ve profesyonel yarış yakıtları.
              </p>
              <div class="hero-features-list">
                <span><i class="fas fa-check-circle"></i> Oktan Arttırıcı</span>
                <span><i class="fas fa-check-circle"></i> E85 & E98 Etanol</span>
                <span><i class="fas fa-check-circle"></i> Stoktan Aynı Gün</span>
              </div>
              <div class="hero-cta-btn">
                <span>Ürünleri İncele</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
            <div class="hero-product-float">
              <img
                src="/images/banners/artoil-banner.png"
                alt="Yakıt Katkıları"
                class="hero-float-img"
              />
            </div>
          </a>
        </article>

        <!-- Right 2 Brand Banners Grid (VP Racing, Liqui Moly) -->
        <div class="banner-mosaic-right">
          <!-- VP Racing Banner -->
          <article class="brand-banner-card card-shell">
            <a href="#vp-racing" class="brand-card-link" aria-label="VP Racing Oktan Arttırıcı">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">VP Racing</span>
                    <span class="card-count-badge">Performans</span>
                  </div>
                  <h3 class="card-product-title">VP Octanium Oktan</h3>
                  <p class="card-visc-tag">8 Puana Kadar Oktan Artışı & Vuruntu Önleyici</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/products/vp-racing-2857-oktan-arttirici-946-ml.jpg"
                    alt="VP Racing Madditive Octanium"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- Liqui Moly Banner -->
          <article class="brand-banner-card card-mobil">
            <a href="#liqui-moly" class="brand-card-link" aria-label="Liqui Moly Cera Tec">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Liqui Moly</span>
                    <span class="card-count-badge">Seramik</span>
                  </div>
                  <h3 class="card-product-title">Cera Tec Motor Koruyucu</h3>
                  <p class="card-visc-tag">Mikro Seramik Katkılı Sürtünme Azaltıcı</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/products/liqui-moly-ceratec-seramik-bazli-motor-onarici-(7181)-300-ml.jpg"
                    alt="Liqui Moly Cera Tec"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- BRAND SECTION: JET MOTORSPORT -->
  {jetProducts.length > 0 && (
    <section id="jet" class="brand-catalog-section">
      <div class="container">
        <div class="brand-heading-center">
          <h2 class="section-heading-lg">JET Motorsport Yarış Yakıtları & Katkıları</h2>
          <p class="section-subheading-clean">
            Drag, drift ve pist yarışları için saf E85, E98, M100 metanol, NTM ve diferansiyel dişli yağları.
          </p>
        </div>
        <div class="section-divider-line"></div>

        <div class="product-cards-grid">
          {jetProducts.map(p => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BRAND SECTION: VP RACING -->
  {vpProducts.length > 0 && (
    <section id="vp-racing" class="brand-catalog-section">
      <div class="container">
        <div class="brand-heading-center">
          <h2 class="section-heading-lg">VP Racing Oktan Arttırıcılar</h2>
          <p class="section-subheading-clean">
            Yüksek sıkıştırmalı ve turbo araçlarda avans vuruntusunu önleyen dünya lideri oktan arttırıcı.
          </p>
        </div>
        <div class="section-divider-line"></div>

        <div class="product-cards-grid centered-flex-grid">
          {vpProducts.map(p => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BRAND SECTION: LIQUI MOLY -->
  {lmProducts.length > 0 && (
    <section id="liqui-moly" class="brand-catalog-section">
      <div class="container">
        <div class="brand-heading-center">
          <h2 class="section-heading-lg">Liqui Moly Seramik Motor Katkıları</h2>
          <p class="section-subheading-clean">
            Mikro-seramik katı yağlayıcı teknolojisi ile sürtünmeyi ve motor aşınmasını minimize eden Cera Tec.
          </p>
        </div>
        <div class="section-divider-line"></div>

        <div class="product-cards-grid centered-flex-grid">
          {lmProducts.map(p => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SEO CONTENT ARTICLE -->
  <section class="seo-text-section">
    <div class="container">
      <div class="section-divider-line"></div>
      <div class="seo-content-box">
        <h3>Yakıt Katkısı & Yarış Yakıtı Nedir?</h3>
        <p>Yakıt katkısı ve yarış yakıtları; içten yanmalı motorlarda yanma verimini maksimize etmek, silindir içi vuruntuyu (detonasyon) engellemek, enjektör ve supap temizliğini sağlamak amacıyla geliştirilmiş özel kimyasal bileşenlerdir. Özellikle modifiye edilmiş yüksek basınçlı turbo ve atmosferik motorlarda motor güvenliğini ve maksimum beygir gücünü garanti altına alır.</p>

        <h3>Oktan Arttırıcıların Önemi ve Detonasyon Önleme</h3>
        <p>Yüksek sıkıştırma oranı ve yüksek turbo basıncına sahip motorlarda düşük oktanlı yakıt kullanıldığında, buji ateşlemesinden önce kontrolsüz patlama (detonasyon/vuruntu) meydana gelir. VP Racing Octanium ve JET Booster gibi profesyonel oktan arttırıcılar, yakıtın oktan değerini 8 puana kadar yükselterek erken ateşlemeyi önler, avans haritalarının daha agresif ayarlanabilmesini sağlar ve motor kırılmalarının önüne geçer.</p>

        <h3>E85, E98 ve Metanol Yarış Yakıtları</h3>
        <p>Etanol ve metanol bazlı yarış yakıtları, standart benzine kıyasla silindir içine çok daha yüksek gizli buharlaşma ısısı sunarak emme havasını dramatik şekilde soğutur. Bu soğutma etkisi, yanma odası sıcaklığını düşürür, motorun daha fazla hava-yakıt karışımı emebilmesine olanak tanır ve tekerleğe aktarılan tork ile gücü belirgin ölçüde yükseltir.</p>
      </div>
    </div>
  </section>

  <!-- HOME BLOG SECTION -->
  <section class="home-blog-section">
    <div class="container">
      <div class="section-title-wrap">
        <div class="section-heading-row">
          <span class="badge badge-amber">Rehberler & Teknik Bilgiler</span>
          <h2 class="section-heading">Yakıt Katkısı Blog</h2>
        </div>
        <a href="/blog" class="brand-count-tag brand-count-link">Tüm Yazıları Gör ({blogPosts.length}) →</a>
      </div>

      <div class="blog-grid">
        {blogPosts.slice(0, 3).map(post => (
          <article class="blog-card">
            <div class="blog-card-img">
              <img src={post.image} alt={post.title} loading="lazy" />
            </div>
            <div class="blog-card-body">
              <span class="blog-date">{post.date}</span>
              <h3 class="blog-card-title">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h3>
              <p class="blog-card-desc">{post.summary}</p>
              <a href={`/blog/${post.slug}`} class="blog-read-more">Devamını Oku →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .centered-flex-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
</style>
